{
  "name": "mcp-server-eventkit",
  "version": "0.1.0",
  "private": true,
  "description": "Security-focused, read-only MCP server for Apple Reminders and Calendar via EventKit.",
  "author": "Chris Griffin",
  "contributors": [
    "Frad Lee <https://frad.me>"
  ],
  "license": "MIT",
  "keywords": [
    "mcp",
    "apple",
    "reminders",
    "calendar",
    "events",
    "automation"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "bin": {
    "mcp-server-eventkit": "./dist/index.js"
  },
  "files": [
    "bin/event",
    "bin/event-disclaim",
    "dist/",
    "scripts/build-event.mjs",
    "scripts/event-Info.plist",
    "scripts/event.entitlements",
    "scripts/disclaim.c"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:event": "node scripts/build-event.mjs",
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:event",
    "test": "NODE_NO_WARNINGS=1 jest",
    "test:ci": "NODE_NO_WARNINGS=1 jest --coverage",
    "lint": "pnpm exec biome check . && pnpm exec tsc --noEmit --project tsconfig.json",
    "check": "pnpm run lint && pnpm run test:ci"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "exit-on-epipe": "1.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@swc/core": "1.15.43",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.0",
    "jest": "30.4.2",
    "jest-environment-node": "30.4.1",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264"
}
